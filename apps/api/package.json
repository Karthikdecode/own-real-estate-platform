{
  "name": "@real-estate/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express REST API (modular monolith) for the Real Estate Platform.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typeorm": "tsx node_modules/typeorm/cli.js",
    "db:migrate": "pnpm typeorm migration:run -d src/database/data-source.ts",
    "db:migrate:revert": "pnpm typeorm migration:revert -d src/database/data-source.ts",
    "db:migration:show": "pnpm typeorm migration:show -d src/database/data-source.ts",
    "db:migration:generate": "pnpm typeorm migration:generate -d src/database/data-source.ts",
    "db:migration:create": "pnpm typeorm migration:create",
    "db:migrate:prod": "node node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@real-estate/contracts": "workspace:*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jose": "6.2.16",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "swagger-ui-express": "5.0.1",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
