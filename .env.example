# =============================================================================
# Real Estate Platform - environment reference
#
# Create your local .env with:   pnpm setup:env
# (copies this file and generates random local-only secrets; never overwrites)
#
# One root .env is shared by:
#   - apps/api            (reads every API / DATABASE / auth / storage value)
#   - apps/web            (reads only NEXT_PUBLIC_* and API_INTERNAL_BASE_URL)
#   - docker-compose.yml  (reads the DATABASE_* values)
# Never commit .env. Empty values below are required and must be filled in.
# =============================================================================

# ---------- Runtime ----------
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ---------- API (apps/api) ----------
API_PORT=4000
API_BASE_PATH=/api/v1
# Public origin of the API. Used for Swagger, uploaded-image URLs and the CSRF origin allowlist.
API_PUBLIC_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API with credentials (CORS + CSRF origin check).
WEB_ORIGIN=http://localhost:3000
# Express "trust proxy": false | true | <number of hops> | <comma-separated IPs/subnets>
TRUST_PROXY=false

# ---------- Authentication (apps/api) ----------
# Required. HMAC secret for access-token JWTs, at least 32 characters (pnpm setup:env generates one).
JWT_ACCESS_SECRET=
# Access token lifetime (short-lived) and refresh token lifetime, in seconds.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# ---------- PostgreSQL (apps/api + docker/docker-compose.yml) ----------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=real_estate
DATABASE_USERNAME=real_estate
# Required. Local-only password (pnpm setup:env generates one). Never reuse in production.
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Log every SQL statement (development troubleshooting only).
DATABASE_LOGGING=false

# ---------- File storage (local disk only) ----------
# Directory for uploaded property images. Relative paths resolve from apps/api.
# Files are served by the API at <API_PUBLIC_URL>/uploads/<storage-key>.
UPLOADS_DIR=storage/uploads

# ---------- Web (apps/web) ----------
# Browser-visible values. Only variables prefixed with NEXT_PUBLIC_ reach client-side code.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, server-only: base URL Next.js uses when rendering on the server
# (e.g. http://api:4000/api/v1 inside a container network). Falls back to NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_BASE_URL=
